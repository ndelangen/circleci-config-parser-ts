{
  "name": "@ndelangen/circleci-config-parser",
  "version": "0.0.0",
  "description": "A parsing library for CircleCI configuration files, powered by the CircleCI Config SDK",
  "directories": {
    "lib": "lib"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "format": "oxfmt",
    "lint": "oxlint --type-aware",
    "prettier": "prettier --write .",
    "release": "pnpm changeset publish",
    "test": "vitest"
  },
  "author": {
    "name": "CircleCI Community and Partner Engineering Team",
    "email": "community-partner@circleci.com"
  },
  "license": "ISC",
  "dependencies": {
    "@ndelangen/circleci-config-sdk": "https://pkg.pr.new/ndelangen/circleci-config-sdk-ts/@ndelangen/circleci-config-sdk@1",
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.6",
    "@types/node": "^14.18.33",
    "@types/wicg-file-system-access": "^2020.9.5",
    "oxfmt": "^0.11.0",
    "oxlint": "^1.26.0",
    "oxlint-tsgolint": "^0.5.0",
    "pkg-pr-new": "^0.0.57",
    "tsdown": "^0.16.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts"
}
